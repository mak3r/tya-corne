/*
 * mak3r keymap for the Typeractive Corne (ZMK).
 *
 * GENERATED by scripts/generate_keymap.py from halcyon-corne's
 * keyboards/splitkb/halcyon/corne/keymaps/mak3r/keymap.json -- do not edit
 * by hand. Change the shared layout (halcyon-corne's keymap.json) and
 * regenerate.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // Home-row mod-tap (QMK LCTL_T/RCTL_T). tap-preferred + 200ms is the
        // closest match to QMK's default mod-tap behavior.
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
            &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T         &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSPC
            &kp ESC     &kp A       &kp S       &hm LCTRL D &kp F       &kp G         &kp H       &kp J       &hm RCTRL K &kp L       &kp SEMI    &kp SQT
            &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B         &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp RSHFT
                                                &kp LGUI    &mo 1       &kp SPACE     &kp RET     &mo 2       &kp RGUI
            >;
        };
        layer_1 {
            display-name = "Symbols";
            bindings = <
            &kp GRAVE     &kp KP_N1     &kp KP_N2     &kp KP_N3     &kp KP_N4     &kp KP_N5       &kp KP_N6     &kp KP_N7     &kp KP_N8     &kp KP_N9     &kp KP_N0     &kp BSPC
            &kp LS(GRAVE) &kp LS(N1)    &kp LS(N2)    &kp LS(N3)    &kp LS(N4)    &kp LS(N5)      &kp LS(N6)    &kp LS(N7)    &kp LS(N8)    &kp LS(N9)    &kp LS(N0)    &kp BSLH
            &kp LSHFT     &kp KP_MINUS  &kp KP_EQUAL  &kp LBKT      &kp RBKT      &kp LS(MINUS)   &kp LS(EQUAL) &kp LS(LBKT)  &kp LS(RBKT)  &kp KP_DOT    &kp LS(BSLH)  &none
                                                      &trans        &trans        &trans          &trans        &sl 3         &trans
            >;
        };
        layer_2 {
            display-name = "Nav";
            bindings = <
            &kp LG(Z)     &kp LG(X)     &kp LG(C)     &kp LG(V)     &kp LG(R)     &none           &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &none         &kp DEL
            &kp LALT      &none         &none         &trans        &none         &none           &trans        &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &none
            &trans        &none         &none         &kp RC(LEFT)  &kp LC(RIGHT) &trans          &none         &none         &none         &none         &none         &trans
                                                      &trans        &sl 3         &trans          &trans        &trans        &trans
            >;
        };
        layer_3 {
            display-name = "Function";
            bindings = <
            &none              &kp F1             &kp F2             &kp F3             &kp F4             &kp F5               &kp F6             &kp F7             &kp F8             &kp F9             &kp F10            &bootloader
            &none              &kp F11            &kp F12            &sl 4              &kp LS(LG(N4))     &none                &kp C_VOL_DN       &kp C_VOL_UP       &kp C_MUTE         &caps_word         &tog 4             &tog 5
            &none              &none              &none              &none              &none              &none                &kp C_REWIND       &kp C_PLAY_PAUSE   &kp C_FAST_FORWARD &none              &none              &none
                                                                     &trans             &trans             &trans               &trans             &trans             &trans
            >;
        };
        layer_4 {
            display-name = "Mouse";
            bindings = <
            &trans          &trans          &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans          &trans
            &trans          &kp F13         &mkp RCLK       &mkp MCLK       &mkp LCLK       &trans            &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT &trans
            &trans          &trans          &trans          &trans          &trans          &trans            &trans          &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &trans
                                                            &trans          &to 0           &trans            &trans          &to 0           &trans
            >;
        };
        layer_5 {
            display-name = "Return2";
            bindings = <
            &out OUT_TOG   &trans         &trans         &trans         &trans         &studio_unlock   &trans         &trans         &trans         &trans         &trans         &trans
            &bt BT_CLR     &trans         &trans         &trans         &trans         &trans           &trans         &trans         &trans         &trans         &trans         &trans
            &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &trans           &trans         &trans         &trans         &trans         &trans         &trans
                                                         &trans         &to 0          &trans           &trans         &to 0          &trans
            >;
        };
        layer_6 {
            display-name = "Unused6";
            bindings = <
            &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                 &trans &trans &trans   &trans &trans &trans
            >;
        };
        layer_7 {
            display-name = "Unused7";
            bindings = <
            &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                 &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
